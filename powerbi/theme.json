{
  "name": "HR Attrition Intelligence Theme",
  "dataColors": [
    "#E11D48",
    "#2563EB",
    "#0D9488",
    "#F59E0B",
    "#8B5CF6",
    "#EC4899",
    "#0284C7",
    "#10B981"
  ],
  "background": "#F8FAFC",
  "foreground": "#0F172A",
